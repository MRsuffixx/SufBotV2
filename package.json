{
  "name": "discord-bot-ecosystem",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade Discord bot ecosystem with a Next.js dashboard",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf packages/*/dist apps/*/dist packages/*/.tsbuildinfo apps/*/.tsbuildinfo",
    "dev:bot": "npm run dev --workspace apps/bot",
    "dev:web": "npm run dev --workspace apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b --noEmit",
    "db:generate": "npm run db:generate --workspace packages/database",
    "db:migrate": "npm run db:migrate --workspace packages/database",
    "db:deploy": "npm run db:deploy --workspace packages/database",
    "db:studio": "npm run db:studio --workspace packages/database"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
