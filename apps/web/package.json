{
  "name": "@bot/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "tsc -b && next build",
    "clean": "rm -rf dist .next .tsbuildinfo",
    "start": "next start -p 3000",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "next lint"
  },
  "dependencies": {
    "@bot/database": "*",
    "@bot/shared": "*",
    "@prisma/client": "^5.19.1",
    "clsx": "^2.1.1",
    "discord.js": "^14.16.3",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
