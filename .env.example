# =====================================================
# Discord Bot Ecosystem - Environment Configuration
# =====================================================
# Copy to .env and fill in real values. Never commit .env.

# ---- Shared ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Postgres (consumed by docker-compose AND Prisma) ----
# The host is "postgres" inside Docker and "localhost" for local dev.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=discord_bot
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_bot?schema=public

# ---- Discord Bot ----
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=replace_me_bot_token
# Application (client) ID
DISCORD_CLIENT_ID=replace_me_client_id
# Optional: secondary client secret is also used for OAuth below
# (kept separate to allow rotation without affecting the bot)
DISCORD_BOT_CLIENT_SECRET=replace_me_bot_client_secret
# Comma-separated guild IDs for guild-scoped command registration during dev
# Leave empty for global commands (slower propagation)
DEV_GUILD_IDS=
# Port the bot's internal API listens on (used by the dashboard to read
# bot stats over the private Docker network).  Set to 0 to disable.
BOT_API_PORT=3001
# Shared secret between the bot and the dashboard.  Must be identical in
# both services.  Use `openssl rand -hex 32` to generate.
INTERNAL_API_TOKEN=replace_with_a_long_random_string_at_least_32_chars

# ---- Web Dashboard (Next.js) ----
# Public origin (no trailing slash), used for OAuth redirects and absolute links
WEB_BASE_URL=http://localhost:3000
# Long random string used to sign session cookies
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars
# Public Discord OAuth credentials used by the dashboard
DISCORD_WEB_CLIENT_ID=replace_me_client_id
DISCORD_WEB_CLIENT_SECRET=replace_me_web_client_secret
# OAuth scopes (space separated) requested by the dashboard
OAUTH_SCOPES=identify guilds

# ---- Security / Rate limiting ----
# Comma-separated list of origins allowed to call the API (CORS)
WEB_ALLOWED_ORIGINS=http://localhost:3000
# Bot rate limit: max interactions per user per window
BOT_RATE_LIMIT_MAX=5
BOT_RATE_LIMIT_WINDOW_MS=10000
# API rate limit: max requests per IP per window
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000

# ---- Optional integrations ----
# Sentry DSN for error reporting (leave empty to disable)
SENTRY_DSN=
